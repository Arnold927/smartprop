{
  "name": "smartprop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npx tsx watch server/index.ts\" \"npm run client:dev\"",
    "dev:server": "npx tsx watch server/index.ts",
    "client:dev": "cd client && npm install --silent && npx vite",
    "build": "npm run build:client",
    "build:client": "cd client && npm install && npx vite build",
    "start": "node dist/server/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "preview": "cd client && npx vite preview",
    "setup": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
