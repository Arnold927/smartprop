# ============================================================
# SmartProp Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# Neon PostgreSQL (recommended): https://neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/smartprop

# Connection pool size (default: 10). Increase for high-traffic deployments.
# DB_POOL_MAX=10

# --- JWT Secrets (REQUIRED - use long random strings in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here_change_this
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here_change_this

# --- Server ---
# Public URL of your app (used in password reset emails etc.)
APP_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# --- CORS (comma-separated list of allowed frontend origins) ---
# In production, set this to your frontend domain, e.g. https://app.smartprop.co.ke
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# --- Optional: Email (Resend) ---
# Get your key at: https://resend.com
# RESEND_API_KEY=re_your_resend_api_key
# FROM_EMAIL=SmartProp <noreply@yourdomain.com>
# APP_NAME=SmartProp

# --- Optional: M-PESA Integration ---
# MPESA_CONSUMER_KEY=your_mpesa_consumer_key
# MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
# MPESA_SHORTCODE=your_mpesa_shortcode
# MPESA_PASSKEY=your_mpesa_passkey
# MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# --- Optional: SMS (Africa's Talking — preferred for Kenya) ---
# Africa's Talking is ~6× cheaper than Twilio for Kenyan numbers (~KES 0.8/SMS vs KES 5+).
# It has a dedicated Kenya shortcode and works natively on Safaricom, Airtel, and Telkom.
# Critical for guards and caretakers who do not use WhatsApp.
#
# Sign up at https://africastalking.com — sandbox is free for testing.
#
# AT_API_KEY=your_at_api_key_here
# AT_USERNAME=your_at_username_here      # "sandbox" works for dev/testing
# AT_SENDER_ID=SMARTPROP                 # optional registered shortcode / alphanumeric sender ID

# --- Optional: SMS fallback (Twilio) ---
# Used automatically when AT_API_KEY is not set. Valid globally but expensive in Kenya.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# WHATSAPP_API_KEY=your_whatsapp_api_key
# WHATSAPP_PHONE_NUMBER=your_whatsapp_phone_number

# --- File Storage (REQUIRED in production) ---
# SmartProp streams all uploads (lease documents, maintenance photos, receipts)
# directly to S3-compatible cloud storage.  Without these vars the server falls
# back to ./uploads on disk — safe for local dev, but files are LOST on every
# container restart in Railway / Render / Docker Swarm deployments.
#
# ── AWS S3 ────────────────────────────────────────────────────────────────────
# S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_BUCKET=smartprop-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=                          # leave blank for AWS S3
#
# ── Cloudflare R2 (S3-compatible, no egress fees — recommended) ───────────────
# S3_ACCESS_KEY_ID=<R2 Access Key ID>
# S3_SECRET_ACCESS_KEY=<R2 Secret Access Key>
# S3_BUCKET=smartprop-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# Aliases: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_BUCKET / AWS_REGION
# are also accepted for backward compatibility.
#
# Bucket policy: make the bucket private; URLs are stored as-is and returned to
# authenticated clients.  For public read access add a bucket policy or use
# Cloudflare R2's "Public Bucket" feature.

# --- Optional: Exchange Rates (diaspora module) ---
# Frankfurter (https://api.frankfurter.app) is used by default — free, no key needed.
# For better KES rates (more reliable), add an Open Exchange Rates key (free tier = 1000 req/mo):
# https://openexchangerates.org/signup/free
# OPENEXCHANGERATES_API_KEY=your_oxr_app_id_here

# --- Anthropic AI (virtual assistant) ---
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Ardhisasa Land Registry (Kenya title deed verification) ───────────────────
# Sign up at https://ardhisasa.lands.go.ke / eCitizen developer portal.
# Without these, the system runs in SANDBOX mode (realistic fake responses,
# clearly labelled "[SANDBOX]" in the UI — safe for development/demo).
ARDHISASA_API_URL=https://api.ardhisasa.go.ke/v1
ARDHISASA_CLIENT_ID=your_ardhisasa_client_id
ARDHISASA_CLIENT_SECRET=your_ardhisasa_client_secret
# Alternative: some integrations issue a static API key instead of OAuth2
# ARDHISASA_API_KEY=your_static_api_key

# ── KRA eTIMS (Electronic Tax Invoice Management System) ──────────────────────
# Register at: https://etims.kra.go.ke or via eTIMS VSCU/OSCU provisioning.
# Required for submitting electronic tax invoices directly to KRA.
#
# Sandbox  (test, default):    ETIMS_SANDBOX=true   + sandbox base URL
# Live     (production):       ETIMS_SANDBOX=false  + production TIN/BHF
#
ETIMS_SANDBOX=true
ETIMS_SANDBOX_URL=https://etims-sbx.kra.go.ke/etims-api
ETIMS_BASE_URL=https://etims-api.kra.go.ke/etims-api
#
# These are stored per-organisation in the etims_device_info table (set via UI).
# You can also seed defaults here for single-org deployments:
# ETIMS_DEFAULT_TIN=P051234567X
# ETIMS_DEFAULT_BHF_ID=00
# ETIMS_DEFAULT_DEVICE_SERIAL=VSCU-123456
