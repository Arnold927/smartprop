{
  "name": "smart-prop-mobile",
  "version": "1.0.0",
  "description": "Smart Prop Mobile Applications for Android and iOS",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace SmartProp.xcworkspace -scheme SmartProp -configuration Release",
    "sync:data": "node scripts/sync-mobile-data.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.19.5",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@tanstack/react-query": "^5.90.15",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.48.2",
    "react-native": "0.74.7",
    "react-native-camera": "^4.2.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-document-picker": "^9.1.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-image-picker": "^7.0.3",
    "react-native-maps": "^1.8.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.15.4",
    "react-native-vector-icons": "^10.0.2"
  },
  "devDependencies": {
    "@react-native/metro-config": "^0.72.11",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.72.5",
    "@types/react-native-push-notification": "^8.1.4",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "typescript": "4.8.4"
  },
  "engines": {
    "node": ">=16"
  }
}
